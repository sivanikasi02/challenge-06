#include <stdio.h>
#include <math.h>

int main()
{
    int choice, n, i;
    long long fact;
    double a, b, c, x, D, r1, r2;

    do
    {
        printf("\n--- MENU ---\n");
        printf("1. Linear Equation\n");
        printf("2. Factorial\n");
        printf("3. Quadratic Equation\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Enter a and b: ");
                scanf("%lf %lf", &a, &b);

                if (a != 0)
                {
                    x = -b / a;
                    printf("x = %.2lf\n", x);
                }
                else if (b == 0)
                {
                    printf("Infinitely many solutions\n");
                }
                else
                {
                    printf("No solution\n");
                }
                break;

            case 2:
                printf("Enter an integer (0 to 12): ");
                scanf("%d", &n);

                if (n < 0 || n > 12)
                {
                    printf("Invalid value\n");
                }
                else
                {
                    fact = 1;

                    for (i = 1; i <= n; i++)
                    {
                        fact = fact * i;
                    }

                    printf("Factorial = %lld\n", fact);
                }
                break;

            case 3:
                printf("Enter a, b and c: ");
                scanf("%lf %lf %lf", &a, &b, &c);

                if (a == 0)
                {
                    printf("Not a quadratic equation\n");
                }
                else
                {
                    D = b * b - 4 * a * c;

                    if (D > 0)
                    {
                        r1 = (-b + sqrt(D)) / (2 * a);
                        r2 = (-b - sqrt(D)) / (2 * a);

                        printf("Two distinct real roots\n");
                        printf("Root 1 = %.2lf\n", r1);
                        printf("Root 2 = %.2lf\n", r2);
                    }
                    else if (D == 0)
                    {
                        r1 = -b / (2 * a);

                        printf("Two equal real roots\n");
                        printf("Root = %.2lf\n", r1);
                    }
                    else
                    {
                        printf("No real roots\n");
                    }
                }
                break;

            case 4:
                printf("Program terminated. Thank you!\n");
                break;

            default:
                printf("Invalid choice. Try again.\n");
        }

    } while (choice != 4);

    return 0;
}
